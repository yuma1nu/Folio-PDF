{
  "name": "folio-pdf-viewer",
  "productName": "Folio PDF",
  "version": "0.1.4",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.cjs",
  "description": "ローカルで使う軽快なPDFビューア",
  "author": "Folio PDF",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && node scripts/build.mjs",
    "start": "node scripts/start.mjs",
    "test": "node --test tests/*.test.ts",
    "test:smoke": "node scripts/smoke.mjs",
    "test:integration": "node scripts/integration.mjs",
    "test:quality": "node scripts/quality.mjs",
    "dist:win": "pnpm build && electron-builder --win nsis --x64",
    "package:dir": "pnpm build && electron-builder --dir --win --x64",
    "test:packaged": "node scripts/packaged-smoke.mjs",
    "test:alignment": "node scripts/alignment.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "electron": "^45.2.1",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.28.0",
    "typescript": "^6.0.0",
    "vite": "^8.0.0",
    "playwright": "^1.58.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "pdfjs-dist": "^5.4.394",
    "pdf-lib": "^1.17.1",
    "lucide-react": "^0.577.0"
  },
  "build": {
    "appId": "jp.folio.pdfviewer",
    "asar": true,
    "directories": {
      "output": "release/0.1.4"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "assets/icon.png",
      "assets/icon.ico",
      "THIRD_PARTY_NOTICES.txt",
      "package.json"
    ],
    "fileAssociations": [
      {
        "ext": "pdf",
        "name": "PDF document",
        "role": "Viewer"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerLanguages": [
        "ja_JP",
        "en_US"
      ],
      "language": "1041",
      "createDesktopShortcut": true
    }
  }
}
